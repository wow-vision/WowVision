<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">

  <Script file="character.lua" />
  <!-- Questie ships a Forever build over its Classic Era database, and
       the quests module prefers it over the native quest lines (which
       the beta serves empty), so the Questie backend loads here too. -->
  <Script file="..\classic\quests\questie.lua" />

  <!-- WoW: Forever (client codename Camelot, TOC suffix _Camelot). The
       client is the modern engine with vanilla content, so the retail
       modules load first and Forever-only modules go here. -->

  <!-- The collections journal and its mount journal come from Mists;
       collections/ replaces the tab bar and adds the other tabs. -->
  <Include file="..\mists\collections\modules.xml" />
  <Include file="collections\modules.xml" />
  <!-- Forever's spellbook is the modern PlayerSpellsFrame, not Mists'. -->
  <Script file="spellbook.lua" />
  <!-- The class talents, the spellbook window's other page. -->
  <Script file="talents.lua" />
  <!-- The professions book and the crafting page are the two pages of the
       retail ProfessionsFrame. -->
  <Script file="professions.lua" />
  <Script file="crafting.lua" />
  <!-- The Legacy window: reward track, challenges, and the Legacy talent
       trees. -->
  <Include file="legacy\modules.xml" />
  <!-- The group finder is the TBC tool on a newer build of the same
       Blizzard addon; lfg.lua adds what that build changed. -->
  <Script file="..\tbc\lfg.lua" />
  <Script file="lfg.lua" />
  <!-- WoW: Forever has no pandemic window: the cooldown manager aura rule
       drops its Pandemic state. -->
  <Script file="cdmAuras.lua" />
  <!-- The gamepad action bars in the bars window (controller support). -->
  <Script file="gamepadBars.lua" />
  <!-- Blizzard's gamepad main menu (the wheel) as a window. -->
  <Script file="gamepadRadial.lua" />
  <!-- WowNav routes (a setting under Navigation): Broesel's engine and route rules, then his navigation data
       (the WoW_NavigationData repository as a submodule), packed by tools/wownav-pack.lua into
       mapdata/WowNavPacked. -->
  <Include file="wownav\modules.xml" />
  <Include file="..\mapdata\WowNavPacked\data.xml" />

</Ui>
