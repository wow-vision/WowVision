<Project Sdk="Microsoft.NET.Sdk">

  <!-- Headless console harness that links the installer's ENGINE files (no
       WinForms, no admin manifest) so the whole download/extract/install
       pipeline can be driven and verified from the command line, with PASS/FAIL
       lines and an exit code. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>WowVisionSelfTest</AssemblyName>
    <RootNamespace>WowVisionInstaller</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The .NET Framework reference assemblies as a package, so the build needs
         no targeting pack installed (CI runners, a fresh dev machine). -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <!-- The engine sources. Left out: Program.cs and the forms. Shortcut.cs and
       SelfUpdater.cs are in — plain file/COM work with no WinForms in them — so
       "selfupdate" can verify a published exe against its published checksum
       without a window or a UAC prompt. The voice installers are linked because
       InstallRunner names them; the harness never runs them
       (InstallOptions.SkipMachineWide). -->
  <ItemGroup>
    <Compile Include="..\WowVisionInstaller\Config.cs"                 Link="Config.cs" />
    <Compile Include="..\WowVisionInstaller\Logger.cs"                 Link="Logger.cs" />
    <Compile Include="..\WowVisionInstaller\Loc.cs"                    Link="Loc.cs" />
    <Compile Include="..\WowVisionInstaller\AppVersion.cs"             Link="AppVersion.cs" />
    <Compile Include="..\WowVisionInstaller\GitHubClient.cs"           Link="GitHubClient.cs" />
    <Compile Include="..\WowVisionInstaller\WowLocator.cs"             Link="WowLocator.cs" />
    <Compile Include="..\WowVisionInstaller\InstallManifest.cs"        Link="InstallManifest.cs" />
    <Compile Include="..\WowVisionInstaller\AddonInstaller.cs"         Link="AddonInstaller.cs" />
    <Compile Include="..\WowVisionInstaller\ReleasePackage.cs"         Link="ReleasePackage.cs" />
    <Compile Include="..\WowVisionInstaller\GameSettings.cs"           Link="GameSettings.cs" />
    <Compile Include="..\WowVisionInstaller\TocSync.cs"                Link="TocSync.cs" />
    <Compile Include="..\WowVisionInstaller\Shortcut.cs"               Link="Shortcut.cs" />
    <Compile Include="..\WowVisionInstaller\PathMemory.cs"             Link="PathMemory.cs" />
    <Compile Include="..\WowVisionInstaller\SelfUpdater.cs"            Link="SelfUpdater.cs" />
    <Compile Include="..\WowVisionInstaller\InstallTarget.cs"          Link="InstallTarget.cs" />
    <Compile Include="..\WowVisionInstaller\InstallRunner.cs"          Link="InstallRunner.cs" />
    <Compile Include="..\WowVisionInstaller\Sapi2SrInstaller.cs"       Link="Sapi2SrInstaller.cs" />
    <Compile Include="..\WowVisionInstaller\WindowsVoicesInstaller.cs" Link="WindowsVoicesInstaller.cs" />
    <Compile Include="..\WowVisionInstaller\LogCollector.cs"           Link="LogCollector.cs" />
    <Compile Include="..\WowVisionInstaller\ManagedAddons.cs"          Link="ManagedAddons.cs" />
    <Compile Include="..\WowVisionInstaller\LoginToolInstaller.cs"     Link="LoginToolInstaller.cs" />
  </ItemGroup>

</Project>
